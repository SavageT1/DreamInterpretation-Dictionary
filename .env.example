# Server-only production secrets. Configure these in Vercel.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
STRIPE_PRICE_ID="price_..."
ENTITLEMENT_SECRET="A_LONG_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase client key: keep this out of git and set it in your deployment env.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
