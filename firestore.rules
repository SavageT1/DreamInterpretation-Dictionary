rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validDream(data, dreamId) {
      return data.keys().hasAll([
          'id', 'title', 'dream', 'dreamBookNotes', 'interpretation', 'createdAt', 'starred'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'dream', 'dreamBookNotes', 'interpretation', 'createdAt', 'starred'
        ])
        && data.id == dreamId
        && data.title is string && data.title.size() <= 200
        && data.dream is string && data.dream.size() <= 6000
        && data.dreamBookNotes is string && data.dreamBookNotes.size() <= 2000
        && data.interpretation is string && data.interpretation.size() <= 12000
        && data.createdAt is string
        && data.starred is bool;
    }

    match /users/{userId}/dreams/{dreamId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validDream(request.resource.data, dreamId);
    }
  }
}
