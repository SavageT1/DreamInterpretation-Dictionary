rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: dreams
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - owner UID
    //   - text: string (required, < 5000 chars) - dream content
    //   - interpretation: string (optional, < 5000 chars)
    //   - imageUrl: string (optional, < 2048 chars)
    //   - date: string (optional) 
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validDream(data) {
      return hasRequiredFields(['userId', 'text']) &&
             data.userId is string &&
             data.text is string && data.text.size() < 5000 &&
             (!('interpretation' in data) || (data.interpretation is string && data.interpretation.size() < 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2048)) &&
             (!('date' in data) || data.date is string);
    }

    // ===============================================================
    // Match Rules
    // ===============================================================
    match /dreams/{dreamId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && validDream(request.resource.data) && hasOnlyAllowedFields(['userId', 'text', 'interpretation', 'imageUrl', 'date']) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId) && validDream(request.resource.data) && hasOnlyAllowedFields(['userId', 'text', 'interpretation', 'imageUrl', 'date']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // Forbid client-side updates. Usage tracking must happen server-side via Admin SDK.
      allow create, update, delete: if false; 
    }
  }
}
